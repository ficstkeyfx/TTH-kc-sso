@page "/reset-password"
@layout LoginLayout
@using QLNguoiDung.Services
@inject NavigationManager UriHelper
@inject NotificationService NotificationService
@inject HttpClient Http
@inject ApiServices ApiService
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using Radzen

<PageTitle>Đặt lại mật khẩu</PageTitle>
<head>
    <link href="css/reset-password.css" rel="stylesheet" />
</head>

<div class="reset-password min-vh-100 sm:py-16 flex-column">
    <div class="row justify-content-center align-items-center">
        <div class="col-6" style="width: 45%">
            <div class="card shadow-2-strong" style="border-radius: 0.5rem">
                <div class="card-body p-8">
                    <div style="display: flex; align-items: center; justify-content: center">
                        <img src="logo.png"
                             style="height:90px;width:auto; margin: 20 20 20 0; padding-right: 30px;" />
                        <div class="text-center">
                            <strong style="font-size: 1.8rem; margin-left:-20px; color: #112572">ĐẶT LẠI MẬT KHẨU</strong>
                        </div>
                    </div>
                    <div style="margin-left: 2rem; margin-right: 1.7rem">
                        @if (currentStep == 1)
                        {
                            <RadzenTemplateForm TItem="UsernameModel" Data=@usernameModel Submit="@HandleUsernameSubmit">
                                <ChildContent Context="ctx">
                                    <RadzenFormField style="width: 100%; margin-top: 1.5rem" Text="Tên tài khoản">
                                        <Start>
                                            <RadzenIcon Icon="account_circle" />
                                        </Start>
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="@usernameModel.Username" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <div style="text-align: left; margin-top: 1.5rem">
                                        <RadzenLink Path="/login" Text="Quay lại đăng nhập" Style="color: #112572;" />
                                    </div>

                                    <RadzenButton style="margin-top: 1.5rem; width: 100%; background-color:#112572"
                                                  ButtonType="ButtonType.Submit"
                                                  class="rz-info-darker"
                                                  Text="Tiếp tục"
                                                  IsBusy="@isBusy"
                                                  Disabled="@isBusy">
                                    </RadzenButton>
                                </ChildContent>
                            </RadzenTemplateForm>
                        }
                        else if (currentStep == 2)
                        {
                            <RadzenTemplateForm TItem="ResetPasswordModel" Data=@resetPasswordModel Submit="@HandleResetPasswordAsync">
                                <ChildContent Context="ctx">
                                    <RadzenFormField style="width: 100%; margin-top: 1.5rem" Text="Tên tài khoản">
                                        <Start>
                                            <RadzenIcon Icon="account_circle" />
                                        </Start>
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="@resetPasswordModel.Username" Disabled="true" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField style="width: 100%; margin-top: 1.5rem" Text="Email">
                                        <Start>
                                            <RadzenIcon Icon="email" />
                                        </Start>
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="@resetPasswordModel.Email" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField style="width: 100%; margin-top: 1.5rem" Text="Số điện thoại">
                                        <Start>
                                            <RadzenIcon Icon="phone" />
                                        </Start>
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="@resetPasswordModel.SDT" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField style="width: 100%; margin-top: 1.5rem" Text="Số CCCD">
                                        <Start>
                                            <RadzenIcon Icon="badge" />
                                        </Start>
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="@resetPasswordModel.CCCD" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField style="width: 100%; margin-top:1.5rem" Text="Mật khẩu mới">
                                        <Start>
                                            <RadzenIcon Icon="lock" />
                                        </Start>
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="@resetPasswordModel.NewPassword"
                                                           Visible="@(!showPassword)" />
                                            <RadzenPassword @bind-Value="@resetPasswordModel.NewPassword"
                                                            Visible="@showPassword" />
                                        </ChildContent>
                                        <End>
                                            <RadzenButton Icon="@(showPassword ? "visibility" : "visibility_off")"
                                                          Click="@(() => showPassword = !showPassword)"
                                                          Variant="Variant.Text"
                                                          Size="ButtonSize.Small" />
                                        </End>
                                    </RadzenFormField>

                                    <RadzenFormField style="width: 100%; margin-top:1.5rem" Text="Xác nhận mật khẩu">
                                        <Start>
                                            <RadzenIcon Icon="lock" />
                                        </Start>
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="@confirmPassword"
                                                           Visible="@(!showConfirmPassword)" />
                                            <RadzenPassword @bind-Value="@confirmPassword"
                                                            Visible="@showConfirmPassword" />
                                        </ChildContent>
                                        <End>
                                            <RadzenButton Icon="@(showConfirmPassword ? "visibility" : "visibility_off")"
                                                          Click="@(() => showConfirmPassword = !showConfirmPassword)"
                                                          Variant="Variant.Text"
                                                          Size="ButtonSize.Small" />
                                        </End>
                                    </RadzenFormField>

                                    <div style="display: flex; justify-content: space-between; margin-top: 1.5rem">
                                        <RadzenButton ButtonType="ButtonType.Button"
                                                      Text="Quay lại"
                                                      Style="color: #112572; border: 1px solid #112572"
                                                      Click="@(() => currentStep = 1)" />
                                        <RadzenButton ButtonType="ButtonType.Submit"
                                                      Style="background-color:#112572"
                                                      class="rz-info-darker"
                                                      Text="Đặt lại mật khẩu"
                                                      IsBusy="@isBusy"
                                                      Disabled="@isBusy" />
                                    </div>
                                </ChildContent>
                            </RadzenTemplateForm>
                        }
                        else if (currentStep == 3)
                        {
                            <div class="text-center" style="margin-top: 2rem">
                                <RadzenIcon Icon="check_circle" Style="color: #4CAF50; font-size: 5rem" />
                                <h3 style="margin-top: 1rem; color: #112572">Đặt lại mật khẩu thành công!</h3>
                                <p style="margin-top: 1rem">Mật khẩu của bạn đã được cập nhật. Vui lòng đăng nhập bằng mật khẩu mới.</p>
                                <RadzenButton style="margin-top: 1.5rem; width: 100%; background-color:#112572"
                                              ButtonType="ButtonType.Button"
                                              class="rz-info-darker"
                                              Text="Đến trang đăng nhập"
                                              Click="@(() => UriHelper.NavigateTo("/login", true))">
                                </RadzenButton>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int currentStep = 1;
    private UsernameModel usernameModel = new();
    private ResetPasswordModel resetPasswordModel = new();
    private string confirmPassword = "";
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private bool isBusy = false;

    public class UsernameModel
    {
        public string Username { get; set; } = "";
    }

    public class ResetPasswordModel
    {
        public string Username { get; set; } = "";
        public string Email { get; set; } = "";
        public string SDT { get; set; } = "";
        public string CCCD { get; set; } = "";
        public string NewPassword { get; set; } = "";
    }

        private async Task HandleUsernameSubmit()
        {
            if (string.IsNullOrWhiteSpace(usernameModel.Username))
            {
                NotificationService.Notify(NotificationSeverity.Error,
                    "Thông báo",
                    "Vui lòng nhập tên tài khoản");
                return;
            }

            try
            {
                isBusy = true;

                // Tạo HttpClientHandler với cấu hình bỏ qua kiểm tra SSL
                var handler = new HttpClientHandler
                {
                    ServerCertificateCustomValidationCallback = (sender, cert, chain, sslPolicyErrors) => true
                };

                // Tạo HttpClient với HttpClientHandler đã cấu hình
                HttpClient client = new HttpClient(handler)
                {
                    BaseAddress = new Uri("http://localhost:5240/") // Thay thế bằng BaseAddress thực tế
                };

                @* string token = await ApiService.GetTokenAsync();
                client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json")); *@

                // API endpoint để kiểm tra tên tài khoản tồn tại
                var response = await client.GetAsync($"api/Users/CheckUsername?username={usernameModel.Username}");

                if (response.IsSuccessStatusCode)
                {
                    // Đọc nội dung JSON từ response
                    var content = await response.Content.ReadFromJsonAsync<UsernameCheckResult>();
                    
                    if (content != null && content.exists)
                    {
                        // Tài khoản tồn tại, chuyển sang bước 2
                        resetPasswordModel.Username = usernameModel.Username;
                        currentStep = 2;
                    }
                    else
                    {
                        // Tài khoản không tồn tại
                        NotificationService.Notify(NotificationSeverity.Error,
                            "Thông báo",
                            "Tên tài khoản không tồn tại trong hệ thống");
                    }
                }
                else
                {
                    // Lỗi từ API
                    var errorContent = await response.Content.ReadAsStringAsync();
                    NotificationService.Notify(NotificationSeverity.Error,
                        "Thông báo",
                        "Không thể kiểm tra tên tài khoản: " + errorContent);
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error,
                    "Thông báo",
                    "Đã có lỗi xảy ra: " + ex.Message);
            }
            finally
            {
                isBusy = false;
            }
        }

    private async Task HandleResetPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(resetPasswordModel.Email) ||
            string.IsNullOrWhiteSpace(resetPasswordModel.SDT) ||
            string.IsNullOrWhiteSpace(resetPasswordModel.CCCD) ||
            string.IsNullOrWhiteSpace(resetPasswordModel.NewPassword))
        {
            NotificationService.Notify(NotificationSeverity.Error,
                "Thông báo",
                "Vui lòng điền đầy đủ thông tin");
            return;
        }

        if (resetPasswordModel.NewPassword != confirmPassword)
        {
            NotificationService.Notify(NotificationSeverity.Error,
                "Thông báo",
                "Mật khẩu xác nhận không khớp");
            return;
        }

        try
        {
            isBusy = true;

            // Tạo HttpClientHandler với cấu hình bỏ qua kiểm tra SSL
            var handler = new HttpClientHandler
            {
                ServerCertificateCustomValidationCallback = (sender, cert, chain, sslPolicyErrors) => true
            };

            // Tạo HttpClient với HttpClientHandler đã cấu hình
            HttpClient client = new HttpClient(handler)
            {
                    BaseAddress = new Uri("http://localhost:5240/") // Thay thế bằng BaseAddress thực tế
            };

            @* string token = await ApiService.GetTokenAsync();
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json")); *@

            // Gọi API đặt lại mật khẩu
            var response = await client.PostAsJsonAsync("api/ResetPassword/reset-password", resetPasswordModel);

            if (response.IsSuccessStatusCode)
            {
                // Đặt lại mật khẩu thành công, chuyển sang bước 3 (thông báo thành công)
                currentStep = 3;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(NotificationSeverity.Error,
                    "Thông báo",
                    "Không thể đặt lại mật khẩu: " + "Kiểm tra lại thông tin đã nhập");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error,
                "Thông báo",
                "Đã có lỗi xảy ra: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
    public class UsernameCheckResult
    {
        public bool exists { get; set; }
    }
}