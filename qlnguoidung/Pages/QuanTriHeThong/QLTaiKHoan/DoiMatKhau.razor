@page "/DoiMatKhau"
@using System.Net.Http.Json
@using System.IdentityModel.Tokens.Jwt
@inject HttpClient Http
@inject NavigationManager NavManager
@inject NotificationService NotificationService
@inject AuthenServices AuthService
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System.Text.Json;
@inject ApiServices ApiService


<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12"> <!-- thay vì col-md-6 -->
            <div class="card">
                <div class="card-body">
                    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Tên đăng nhập</label>
                            <RadzenTextBox @bind-Value="model.Username" Disabled="true" class="w-100" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Họ và tên</label>
                            <RadzenTextBox @bind-Value="model.FullName" Disabled="true" class="w-100" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mật khẩu hiện tại</label>
                            <RadzenPassword @bind-Value="model.CurrentPassword" class="w-100" />
                            <ValidationMessage For="@(() => model.CurrentPassword)" />
                            @if (showWrongPasswordError)
                            {
                                <div class="text-danger">Mật khẩu hiện tại không đúng</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mật khẩu mới</label>
                            <RadzenPassword @bind-Value="model.NewPassword" class="w-100" />
                            <ValidationMessage For="@(() => model.NewPassword)" />
                            @if (showSamePasswordError)
                            {
                                <div class="text-danger">Mật khẩu mới không được giống mật khẩu hiện tại</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Xác nhận mật khẩu mới</label>
                            <RadzenPassword @bind-Value="model.ConfirmPassword" class="w-100" />
                            <ValidationMessage For="@(() => model.ConfirmPassword)" />
                        </div>

                        <RadzenButton ButtonType="ButtonType.Submit" 
                                    Text="@(isProcessing ? "Đang xử lý..." : "Đổi mật khẩu")"
                                    Disabled="@isProcessing"
                                    Icon="@(isProcessing ? "refresh" : "save")"
                                    BusyText="Đang xử lý..."
                                    IsBusy="@isProcessing"
                                    class="w-100" />
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ChangePasswordModel model = new();
    private bool isProcessing = false;
    private bool showSamePasswordError = false;
    private bool showWrongPasswordError = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity.IsAuthenticated)
        {
            // Extract token
            var token = user.Claims.FirstOrDefault()?.Value;
            if (!string.IsNullOrEmpty(token)){

                // Tạo một JwtSecurityTokenHandler để phân tích token
                var handler = new JwtSecurityTokenHandler();
                var jwtToken = handler.ReadJwtToken(token);

                // Lấy giá trị username
                var username = jwtToken.Claims.FirstOrDefault(c => c.Type == "preferred_username")?.Value
                            ?? jwtToken.Claims.FirstOrDefault(c => c.Type == "sub")?.Value
                            ?? "unknown_user";
                model.Username = username;
                                var firstName = jwtToken.Claims.FirstOrDefault(c => c.Type == "given_name")?.Value ?? "";
                var lastName  = jwtToken.Claims.FirstOrDefault(c => c.Type == "family_name")?.Value ?? "";

                // Ghép thành FullName (có xử lý nếu trống)
                model.FullName = string.Join(" ", new[] { firstName, lastName }.Where(s => !string.IsNullOrWhiteSpace(s)));
            }
            else
            {
                model.Username = user.Identity.Name ?? "unknown_user";
            }
        }
    }

    private async Task HandleSubmit()
    {
        // Reset error states
        showSamePasswordError = false;
        showWrongPasswordError = false;

        // Check if new password is same as current password
        if (model.NewPassword == model.CurrentPassword)
        {
            showSamePasswordError = true;
            NotificationService.Notify(NotificationSeverity.Error, "Mật khẩu mới không được giống mật khẩu hiện tại");
            return;
        }

        try
        {
            isProcessing = true;
            // Tạo HttpClientHandler với cấu hình bỏ qua kiểm tra SSL
            var handler = new HttpClientHandler
            {
                ServerCertificateCustomValidationCallback = (sender, cert, chain, sslPolicyErrors) => true
            };

            // Tạo HttpClient với HttpClientHandler đã cấu hình
            HttpClient client = new HttpClient(handler)
            {
                BaseAddress = new Uri("http://localhost:5240") // Thay thế bằng BaseAddress thực tế
            };
@* 
            string token = await ApiService.GetTokenAsync();
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json")); *@
            var response = await client.PostAsJsonAsync("api/ChangePassword", model);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Đổi mật khẩu thành công");
                NavManager.NavigateTo("/");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                
                // Check if the error is specifically about wrong current password
                if (error.Contains("Invalid current credentials", StringComparison.OrdinalIgnoreCase) || 
                    error.Contains("mật khẩu hiện tại không đúng", StringComparison.OrdinalIgnoreCase))
                {
                    showWrongPasswordError = true;
                    NotificationService.Notify(NotificationSeverity.Error, "Mật khẩu hiện tại không đúng");
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Error, error);
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Lỗi khi đổi mật khẩu");
        }
        finally
        {
            isProcessing = false;
        }
    }

    public class ChangePasswordModel
    {
        public string Username { get; set; }

        public string FullName { get; set; }
        public string CurrentPassword { get; set; }
        public string NewPassword { get; set; }
        public string ConfirmPassword { get; set; }
    }
}