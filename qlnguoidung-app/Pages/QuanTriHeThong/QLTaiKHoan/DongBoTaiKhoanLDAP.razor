<div class="row">
    <div class="col-6">
        <RadzenDataGrid GridLines="DataGridGridLines.Both" AllowPaging="true"
                        PageSizeOptions="@pageSizeOptions" @ref=@GrdTable
                        PagingSummaryFormat="@pagingSummaryFormat" ShowPagingSummary="@showPagerSummary"
                        Data="@listData" Style="--rz-grid-header-font-size: 1rem; --rz-grid-cell-font-size: 1rem"
                        PageSizeText="Bản ghi trên một trang" EmptyText="Không có dữ liệu">
            <Columns>
                <RadzenDataGridColumn TItem="tbUser" Title="STT" Sortable="false" Width="80px"
                                      TextAlign="TextAlign.Center" Frozen="true">
                    <Template Context="ctx">
                        @(listData.IndexOf(ctx) + 1 + 1 + GrdTable.CurrentPage * GrdTable.PageSize)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(user.UserName)" Title="First Name" Frozen="true" Width="160px" />
            </Columns>
        </RadzenDataGrid>
    </div>
    <div class="col-6">
        <RadzenDataGrid GridLines="DataGridGridLines.Both" AllowPaging="true"
                        PageSizeOptions="@pageSizeOptions" @ref=@GrdTable1
                        PagingSummaryFormat="@pagingSummaryFormat" ShowPagingSummary="@showPagerSummary"
                        Data="@listData1" Style="--rz-grid-header-font-size: 1rem; --rz-grid-cell-font-size: 1rem"
                        PageSizeText="Bản ghi trên một trang" EmptyText="Không có dữ liệu">
            <Columns>
                <RadzenDataGridColumn TItem="tbUser" Title="STT" Sortable="false" Width="80px"
                                      TextAlign="TextAlign.Center" Frozen="true">
                    <Template Context="ctx">
                        @(listData1.IndexOf(ctx) + 1 + 1 + GrdTable1.CurrentPage * GrdTable1.PageSize)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(user.UserName)" Title="First Name" Frozen="true" Width="160px" />
            </Columns>
        </RadzenDataGrid>
    </div>
</div>


<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-12 d-flex align-items-center justify-content-center" style="margin-top: 20px;margin-bottom: 10px;width: 100%; background-color: transparent;
                height: 8%;">
                <RadzenButton Icon="save" Style="margin-right:1%;"
                          ButtonStyle="ButtonStyle.Primary" Text="Lưu dữ liệu" Click="@(args => Submit())">
                </RadzenButton>

            <RadzenButton Icon="highlight_off" ButtonStyle="ButtonStyle.Danger" Text="Thoát"
                          Click="@(args => CloseDialog())">
            </RadzenButton>
        </div>
    </div>

</div>

